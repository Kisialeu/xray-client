# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test
*.log
*.ini

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Build output (see build.sh: dist/<os>/xray-cli-<arch>)
dist/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Real VPN configs - secrets, never commit
servers.yaml
*.servers.yaml
server.txt
*.server.txt

# Editor/IDE
.idea/
.zed/
# .vscode/
.DS_Store

config.yaml
*config.yaml

# Install script (contains local paths)
install-macos.sh
