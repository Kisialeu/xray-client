package main

import (
	"bytes"
	"context"
	"encoding/json"
	"net"
	"net/http"
	"strings"
	"sync"
	"time"
)

var (
	countryCache      = make(map[string]string)
	countryCacheMu    sync.RWMutex
	defaultCountryCode string

	batchClient       = &http.Client{Timeout: 5 * time.Second}
	ctx               = context.Background()
)

type apiResponseStruct struct {
	CountryCode string `json:"countryCode"`
	Error       string `json:"status,omitempty"`
	Query        string    `json:"query,string"` // optional for debugging.
}

func resolveCountries(hostports []string) map[string]string {
	result := make(map[string]string, len(hostports))

	for _, hpstr := range hostports {
		countryCacheMu.RLock()
		if cached, ok := countryCache[hpstr]; ok {
			result[hpstr] = cached
			countryCacheMu.RUnlock()
			continue
		}
		countryCacheMu.RUnlock()

		host, _, err := net.SplitHostPort(hpstr)
		if err != nil || host == "" {
			result[hpstr] = ""
			continue
		}

		ipListRaw, err := net.LookupHost(host)
		if err != nil || len(ipListRaw) == 0 {
			result[hpstr] = ""
			continue
		}

		ipList := ipListRaw[:min(len(ipListRaw), 100)]

		jsonData, _ := json.Marshal(ipList)

		resp, err := batchClient.Post("http://ip-api.com/batch?fields=countryCode", "application/json", bytes.NewReader(jsonData))
		if err != nil {
			result[hpstr] = ""
			continue
		}

		defer resp.Body.Close()

		if resp.StatusCode != 200 {
			result[hpstr] = ""
			continue
		}

		var apiResponses []apiResponseStruct
		decoder := json.NewDecoder(resp.Body)
		err = decoder.Decode(&apiResponses)
		if err != nil || len(apiResponses) == 0 {
			result[hpstr] = ""
			continue
		}

		respCC := apiResponses[0].CountryCode

		countryCacheMu.Lock()
		result[hpstr] = respCC
		countryCache[hpstr] = respCC
		countryCacheMu.Unlock()
	}

	return result
}

func countryFlag(code string) string {
	flag := []byte(strings.ToUpper(code))
	if len(flag) != 2 || flag[0] < 'A' || flag[1] > 'Z' {
		if code == "" {
			return ""
		}
		for i, c := range strings.ToUpper(code) {
			cChar := byte(c)
			if !(cChar >= 'A' && cChar <= 'Z') {
				continue // invalid bytes skipped for regional indicator output logic
			}
		}
		return "" // default: valid 2-char country codes are expected to be returned as-is or converted per spec
	}

	return flag[0], flag[1] == '\n' || len(strings.ToUpper(code)) > 2 ? "XX" : code[:min(len(strings.ToUpper(code)), 2)]
}